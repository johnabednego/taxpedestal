# =============================================================================
# TaxPedestal API — environment template
#
# Copy to .env and replace every REPLACE_ME value.
#   cp .env.example .env
#
# Generate the two JWT secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Run it twice. They must be different values.
# =============================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database — MongoDB Atlas connection string
# Atlas: Database > Connect > Drivers. Remember to URL-encode the password and
# to add 0.0.0.0/0 to Network Access if deploying to Render (its egress IPs are
# not static on the free tier).
# -----------------------------------------------------------------------------
MONGODB_URI=REPLACE_ME_mongodb+srv://user:password@cluster.mongodb.net/taxpedestal?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Auth — must be at least 32 characters each, and must not match each other
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_ME_generate_48_random_bytes_base64url
JWT_REFRESH_SECRET=REPLACE_ME_generate_a_DIFFERENT_48_random_bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# -----------------------------------------------------------------------------
# URLs
# APP_URL   -> your Vercel frontend, e.g. https://taxpedestal.vercel.app
# API_URL   -> your Render backend,  e.g. https://taxpedestal-api.onrender.com
# CORS_ORIGINS -> comma-separated exact origins. No wildcards, no trailing slash.
# -----------------------------------------------------------------------------
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Payments — Stripe (worldwide cards, wallets, bank debits)
# Dashboard > Developers > API keys. Use test keys (sk_test_...).
# The webhook secret comes from Developers > Webhooks after you add the endpoint
#   POST {API_URL}/api/v1/webhooks/stripe
# subscribed to: payment_intent.succeeded, payment_intent.payment_failed,
#                charge.refunded
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=REPLACE_ME_sk_test_xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=REPLACE_ME_pk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=REPLACE_ME_whsec_xxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Payments — Paystack (African mobile money: MTN, Telecel, AirtelTigo + cards)
# Dashboard > Settings > API Keys & Webhooks.
# Set the webhook URL there to: {API_URL}/api/v1/webhooks/paystack
# Paystack signs with HMAC-SHA512 using your SECRET key, so no separate
# webhook secret is needed.
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=REPLACE_ME_sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=REPLACE_ME_pk_test_xxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Email
# EMAIL_PROVIDER=console  -> writes emails to the log. Works with no credentials,
#                            which is the right default for grading and demos.
# EMAIL_PROVIDER=resend   -> requires RESEND_API_KEY
# EMAIL_PROVIDER=smtp     -> requires SMTP_HOST and SMTP_PORT
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=TaxPedestal <billing@yourdomain.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Platform administrator — read ONLY by `npm run seed`, never at runtime.
# This is the account for the admin console you hand to the examiner.
# -----------------------------------------------------------------------------
PLATFORM_ADMIN_EMAIL=REPLACE_ME_admin@yourdomain.com
PLATFORM_ADMIN_PASSWORD=REPLACE_ME_choose_a_strong_password

# -----------------------------------------------------------------------------
# Scheduler — set to false on serverless (Vercel). Keep true on Render.
#
# An in-process cron needs a long-lived process. Inside a serverless function
# it either never fires or fires once per cold start, so on Vercel the same
# jobs are driven over HTTP instead — see CRON_SECRET below and
# docs/DEPLOY_VERCEL.md.
# -----------------------------------------------------------------------------
ENABLE_SCHEDULER=true

# -----------------------------------------------------------------------------
# Cron authorisation — REQUIRED on Vercel, unused when ENABLE_SCHEDULER=true.
#
# Vercel Cron calls /api/v1/cron/<job> with `Authorization: Bearer $CRON_SECRET`.
# These routes settle payments and repair ledger balances, so they return 404
# unless the secret is set and matches. At least 16 characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# -----------------------------------------------------------------------------
CRON_SECRET=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
